# Local development reference. Supply the blank required values privately.
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false
# DB_SSL_CA_FILE=/run/certificates/database-ca.pem
BCRYPT_ROUNDS=12
TRUST_PROXY=false
DB_CONNECTION_TIMEOUT_MS=2000
HEALTH_QUERY_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
